.venv/
env/
venv/
ENV/

# Prime Kernel & Engine cache (isolated per workspace, zero git commit pollution)
.prime-kernel/
*.db
*.db-wal
*.db-shm

# PRAXIST Research raw scraping and transient caches (preserves structured dossiers in git)
.prime-research/raw/
.prime-research/tmp/
artifacts/

# IDE and OS
.DS_Store
.vscode/
*.swp
*.swo

# Distribution / Packaging
dist/
*.egg-info/
.eggs/

